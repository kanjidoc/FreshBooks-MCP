node_modules/
dist/
.env
# Per-login OAuth token stores (one file per FreshBooks login) — never commit.
profiles/
# Advisory server lock (pid + start time), written at startup.
.server.lock*
.mcp.json
*.bak
*.tmp
# Token stores written outside profiles/: staged OAuth pairs (<name>.env.pending)
# and last-resort rescue writes (<profile file>.rescue). Global, not scoped to
# profiles/ — the legacy single-login profile's own file IS the repo-root .env,
# so its rescue lands here at the root, which `.env` above does not match.
*.pending
*.rescue
*.js.map
*.d.ts.map
.DS_Store

# Claude Code machine-specific local settings (the bundled .claude/skills/ stays tracked)
.claude/settings.local.json
